{
  "name": "vmix-control",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "mock": "tsx dev/mock-vmix.ts",
    "bodet": "tsx dev/bodet-simulator.ts",
    "build": "tsc -b && vite build && esbuild server/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc -b",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/kumbh-sans": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
